# Never commit .env, session files, login codes or API credentials.
TG_API_ID=YOUR_NUMERIC_API_ID
TG_API_HASH=YOUR_API_HASH
TG_CHANNEL=livefeeds1
TG_SESSION_FILE=./private/telegram.session
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(40))'
BRIDGE_READ_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET
BRIDGE_MAX_AGE_HOURS=24
