# Never commit .env or any Telethon login credentials.
# Render Dashboard -> Web Service -> Environment. Use PRIVATE values for secrets.
TG_API_ID=YOUR_NUMERIC_API_ID
TG_API_HASH=YOUR_SECRET_API_HASH
TG_STRING_SESSION=YOUR_PRIVATE_STRING_SESSION_FROM_LOGIN_PY
TG_CHANNEL=livefeeds1
# Render Blueprint generates a random admin token automatically.
BRIDGE_READ_TOKEN=USE_A_LONG_RANDOM_SECRET_OVER_32_CHARS
BRIDGE_MAX_AGE_HOURS=24

# Legacy local-file session fallback (NOT suitable for Render Free):
# TG_SESSION_FILE=./private/telegram.session
